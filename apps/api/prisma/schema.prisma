generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  RECEPTIONIST
  CLINIC_ADMIN
  DOCTOR
  ADMIN
  MANAGER
}

enum StaffStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum DoctorStatus {
  AVAILABLE
  BUSY
  PAUSED
  AWAY
}

enum EntryStatus {
  WAITING
  IN_CONSULTATION
  COMPLETED
  SKIPPED
  CANCELLED
  MISSED
}

enum SlotType {
  NEW
  FOLLOWUP
}

enum BusinessType {
  CLINIC
  SALON
  BANK
  GOVT
  GENERAL
}

enum SignupRequestStatus {
  PENDING
  CONTACTED
  APPROVED
  REJECTED
}

// A clinic (business) groups staff, doctors, and queues across one or more locations.
model Clinic {
  id                    String                 @id @default(cuid())
  name                  String
  address               String?
  logoUrl               String?
  businessType          BusinessType           @default(CLINIC)
  createdAt             DateTime               @default(now())

  users                 User[] // users belonging to this clinic
  doctors               Doctor[]
  signupRequests        BusinessSignupRequest[]
  locations             Location[]
  subscriptions         Subscription[]
}

// A physical branch of a business (Clinic)
model Location {
  id                    String                 @id @default(cuid())
  clinicId              String
  clinic                Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name                  String
  address               String
  city                  String
  state                 String
  country               String
  postalCode            String
  contactNumber         String
  email                 String?
  googleReviewUrl       String?
  bookingContactNumber  String?
  timeZone              String                 @default("Asia/Kolkata")
  latitude              Float?
  longitude             Float?
  status                String                 @default("ACTIVE") // ACTIVE / INACTIVE
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  users                   UserLocation[]
  doctors                 DoctorLocation[]
  queueEntries            QueueEntry[]
  visits                  Visit[]
  businessSetting         BusinessSetting?
  workflowConfiguration   WorkflowConfiguration?
  receptionistAssignments ReceptionistAssignment[]
  professionalRatings     ProfessionalRating[]
  inviteCodes             InviteCode[]
  schedules               ProfessionalSchedule[]
  prescriptions           Prescription[]
}

model UserLocation {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, locationId])
  @@index([userId])
  @@index([locationId])
}

model DoctorLocation {
  id         String   @id @default(cuid())
  doctorId   String
  doctor     Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([doctorId, locationId])
  @@index([doctorId])
  @@index([locationId])
}

// Maps receptionists to the professionals they manage (1 receptionist : N doctors).
// No rows for a receptionist means they see all clinic professionals (backward compatible).
model ReceptionistAssignment {
  id             String   @id @default(cuid())
  locationId     String
  location       Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  receptionistId String
  receptionist   User     @relation("ReceptionistAssignments", fields: [receptionistId], references: [id], onDelete: Cascade)
  doctorId       String
  doctor         Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([receptionistId, doctorId, locationId])
  @@index([locationId])
  @@index([receptionistId])
  @@index([doctorId])
}

// One-use, time-limited code that lets a receptionist self-register.
// Admin generates these; sharing them is done out-of-band (WhatsApp, email, etc.).
model InviteCode {
  id         String   @id @default(cuid())
  code       String   @unique
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  usedById   String?  @unique
  usedBy     User?    @relation("InviteUsedBy", fields: [usedById], references: [id])
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([locationId])
}

model User {
  id           String  @id @default(cuid())
  role         Role
  name         String
  phone        String? @unique
  email        String? @unique
  loginId      String? @unique
  passwordHash String?

  // ── Google OAuth fields ───────────────────────────────────────────────────
  // googleId: Google's `sub` claim — links the user to their Google account.
  // authProvider: "local" | "google" | "multi" (supports future providers).
  // status: lifecycle state for staff accounts.
  googleId     String?     @unique
  authProvider String      @default("local") // local | google | multi
  status       StaffStatus @default(ACTIVE)  // PENDING on create, ACTIVE after first Google login
  activatedAt        DateTime?   // When PENDING → ACTIVE (first successful Google login)
  lastLoginAt        DateTime?   // Updated on every successful login
  passwordChangedAt  DateTime?   @default(now()) // Invalidates active JWT tokens issued before this time
  createdById        String?     // Who created this account (Super Admin or Clinic Admin)

  // Verification flags. Phone is implicitly verified at signup (OTP for
  // patients, invite-code for staff). Email is always set to false on
  // change and only flipped true once the user confirms an emailed OTP.
  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(true)

  // Pending (unverified) email — the address the user *wants* to change to
  // but hasn't confirmed yet. Used by the verify flow. Null when no change
  // is in flight.
  pendingEmail String?

  // Permanent 4-digit Customer PIN (1000–9999). Assigned at first registration,
  // never changes. Used for customer login and shown to reception staff.
  customerPin String?

  // Populated for RECEPTIONIST role — which clinic they belong to.
  clinicId  String?
  clinic    Clinic?  @relation(fields: [clinicId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctorProfile      Doctor?
  patientEntries     QueueEntry[]  @relation("PatientEntries")
  createdEntries     QueueEntry[]  @relation("CreatedByStaff")
  inviteUsed         InviteCode?   @relation("InviteUsedBy")
  patientVisits      Visit[]       @relation("PatientVisits")
  transfersInitiated TransferLog[] @relation("TransfersInitiated")
  leaves             StaffLeave[]  @relation("UserLeaves")
  approvedLeaves           StaffLeave[]             @relation("ApprovedLeaves")
  receptionistAssignments  ReceptionistAssignment[] @relation("ReceptionistAssignments")
  professionalRatings      ProfessionalRating[]     @relation("PatientRatings")
  locations                UserLocation[]
  pushSubscriptions        PushSubscription[]
  patientPrescriptions     Prescription[]           @relation("PatientPrescriptions")

  @@index([role])
  @@index([clinicId])
  @@index([status])
  @@index([googleId])
  @@index([loginId])
}

model PushSubscription {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint       String    @unique
  p256dh         String
  auth           String
  userAgent      String?
  expirationTime DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
}


// Departments are global labels (General Medicine, Pediatrics, etc.)
// shared across all clinics to avoid duplication.
model Department {
  id      String   @id @default(cuid())
  name    String   @unique
  doctors Doctor[]
}

model Doctor {
  id                 String                 @id @default(cuid())
  userId             String                 @unique
  user               User                   @relation(fields: [userId], references: [id])
  departmentId       String
  department         Department             @relation(fields: [departmentId], references: [id])
  // Which clinic this doctor belongs to. Scopes queue visibility.
  clinicId           String?
  clinic             Clinic?                @relation(fields: [clinicId], references: [id])
  avgConsultMinutes  Int                    @default(7)
  status             DoctorStatus           @default(AVAILABLE)
  delayMinutes       Int                    @default(0)
  // Break handling (Feature 4)
  breakUntil         DateTime?
  breakNote          String?
  // Follow-up slots: every Nth slot reserved for FOLLOWUP patients; 0 = disabled (Feature 6)
  followUpEvery      Int                    @default(0)
  // Insertion gaps (Features 1 & 2)
  walkinGap          Int                    @default(4)
  missedGap          Int                    @default(4)
  entries            QueueEntry[]
  transfersFrom      TransferLog[]          @relation("TransfersFrom")
  transfersTo        TransferLog[]          @relation("TransfersTo")
  schedules          ProfessionalSchedule[]
  maxCustomersPerDay  Int                    @default(50)
  appointmentDuration Int                    @default(15)
  walkinAllowed      Boolean                @default(true)
  prescriptionEnabled Boolean               @default(true)
  prescriptionAllowed Boolean               @default(true)
  followupPriority   Boolean                @default(false)
  specialization     String?
  languages          String?
  experience         Int?
  consultationFee    Int?
  roomNumber              String?
  updatedAt               DateTime                 @updatedAt
  receptionistAssignments ReceptionistAssignment[]
  ratings                 ProfessionalRating[]
  locations               DoctorLocation[]
  prescriptions           Prescription[]
  prescriptionConfig      DoctorPrescriptionConfig?

  @@index([departmentId])
  @@index([clinicId])
  @@index([status])
}

model QueueEntry {
  id              String      @id @default(cuid())
  doctorId        String
  doctor          Doctor      @relation(fields: [doctorId], references: [id])
  locationId      String
  location        Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  patientId       String
  patient         User        @relation("PatientEntries", fields: [patientId], references: [id])
  createdById     String?
  createdBy       User?       @relation("CreatedByStaff", fields: [createdById], references: [id])
  serviceDay      String
  tokenNumber     Int
  status          EntryStatus @default(WAITING)
  priority        Int         @default(0)
  notes           String?
  version         Int         @default(0)
  // Walk-in / rejoin sort position (null = sort by tokenNumber). Feature 1 & 2.
  sortOrder       Float?
  // Whether this entry was added as a walk-in (no prior appointment).
  walkin          Boolean     @default(false)
  missedCount     Int         @default(0)
  // NEW vs FOLLOWUP slot reservation. Feature 6.
  slotType        SlotType    @default(NEW)
  joinedAt        DateTime    @default(now())
  calledAt        DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  visitId         String?
  visit           Visit?      @relation(fields: [visitId], references: [id], onDelete: Cascade)
  appointmentTime DateTime?
  appointmentSlot String?
  rating          ProfessionalRating?

  @@unique([doctorId, serviceDay, tokenNumber])
  @@index([doctorId, status])
  @@index([doctorId, serviceDay])
  @@index([patientId])
  @@index([doctorId, serviceDay, status])
  @@index([patientId, joinedAt])
  @@index([locationId])
  @@index([appointmentTime])
  @@index([doctorId, locationId, status])
  @@index([patientId, doctorId, status])
}

// Business owner signup requests from the public Get Started page.
model BusinessSignupRequest {
  id           String              @id @default(cuid())
  businessName String
  contactName  String
  email        String
  phone        String
  status       SignupRequestStatus @default(PENDING)
  notes        String?
  clinicId     String?
  clinic       Clinic?             @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

model QueueEvent {
  id        String   @id @default(cuid())
  doctorId  String
  entryId   String?
  type      String
  payload   Json
  createdAt DateTime @default(now())

  @@index([doctorId, createdAt])
  @@index([entryId])
}

enum VisitStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Visit {
  id         String      @id @default(cuid())
  locationId String
  location   Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  patientId  String
  patient    User        @relation("PatientVisits", fields: [patientId], references: [id], onDelete: Cascade)
  status     VisitStatus @default(ACTIVE)
  serviceDay String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  entries    QueueEntry[]
  transfers  TransferLog[]
  prescription Prescription?

  @@index([locationId, serviceDay])
  @@index([patientId])
}

model TransferLog {
  id                String   @id @default(cuid())
  visitId           String
  visit             Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  transferredById   String
  transferredBy     User     @relation("TransfersInitiated", fields: [transferredById], references: [id], onDelete: Cascade)
  transferredFromId String
  transferredFrom   Doctor   @relation("TransfersFrom", fields: [transferredFromId], references: [id], onDelete: Cascade)
  transferredToId   String
  transferredTo     Doctor   @relation("TransfersTo", fields: [transferredToId], references: [id], onDelete: Cascade)
  transferredAt     DateTime @default(now())
  transferReason    String?

  @@index([visitId])
  @@index([transferredFromId])
  @@index([transferredToId])
}

model BusinessSetting {
  id                    String   @id @default(cuid())
  locationId            String   @unique
  location              Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  
  businessType          String   @default("CLINIC")
  queueMode             String   @default("LIVE_QUEUE")
  appointmentMode       String   @default("HYBRID")
  
  workingDays           String[] @default(["MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY"])
  businessHolidays      String[] @default([])
  queueStarts           String   @default("09:00")
  queueEnds             String   @default("17:00")
  
  walkinJoinRule        String   @default("END_OF_QUEUE")
  walkinJoinRuleParam   Int      @default(4)
  followupJoinRule      String   @default("END_OF_QUEUE")
  followupJoinRuleParam Int      @default(4)
  emergencyJoinRule     String   @default("TOP_PRIORITY")
  vipJoinRule           String   @default("SEPARATE_QUEUE")
  
  allowWalkins          Boolean  @default(true)
  allowOnlineBooking    Boolean  @default(false)
  allowFollowups        Boolean  @default(true)
  maxDailyBookings      Int      @default(100)
  emergencyQueueEnabled Boolean  @default(true)
  vipQueueEnabled       Boolean  @default(true)

  tokenPrefix           String   @default("TK")
  queueNumberFormat     String   @default("NUMBER")
  etaCalculationMethod  String   @default("MOVING_AVERAGE")
  bufferTime            Int      @default(5)
  gracePeriod           Int      @default(10)
  noShowTimeout         Int      @default(15)
  maxSelfBookingNoShowsPerMonth Int @default(3)

  autoQueueAssignment   Boolean  @default(true)
  bookingControl        String   @default("CUSTOMER_CONTROLLED")
  appointmentInterval   Int      @default(15)
  maxCustomersPerSlot   Int      @default(1)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model ProfessionalSchedule {
  id          String   @id @default(cuid())
  doctorId    String
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  locationId  String
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  dayOfWeek   Int
  startTime   String
  endTime     String
  isHoliday   Boolean  @default(false)
  maxCapacity Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([doctorId, locationId])
  @@index([locationId])
}

model StaffLeave {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation("UserLeaves", fields: [userId], references: [id], onDelete: Cascade)
  type         String     
  startDate    DateTime
  endDate      DateTime
  reason       String?
  status       String     @default("PENDING") 
  approvedById String?
  approvedBy   User?      @relation("ApprovedLeaves", fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([userId])
}

model ProfessionalRating {
  id          String     @id @default(cuid())
  locationId  String
  location    Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  doctorId    String
  doctor      Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientId   String
  patient     User       @relation("PatientRatings", fields: [patientId], references: [id], onDelete: Cascade)
  entryId     String     @unique
  entry       QueueEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  rating      Int
  comment     String?
  createdAt   DateTime   @default(now())

  @@index([doctorId, createdAt])
  @@index([locationId])
  @@index([patientId])
}

model WorkflowConfiguration {
  id         String   @id @default(cuid())
  locationId String   @unique
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  steps      Json     
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model UsageEvent {
  id              String      @id @default(cuid())
  eventType       String      // e.g., TOKEN_CREATED, TOKEN_COMPLETED, etc.
  businessId      String
  locationId      String
  professionalId  String?
  receptionistId  String?
  customerId      String?
  appointmentId   String?
  queueId         String?
  visitId         String?
  referenceId     String?     // For idempotency (e.g. entryId + eventType combo)
  timestamp       DateTime    @default(now())
  metadata        Json?
  billingStatus   String      @default("UNPROCESSED") // UNPROCESSED, BILLED, NON_BILLABLE
  createdAt       DateTime    @default(now())

  @@unique([referenceId])
  @@index([businessId])
  @@index([eventType])
  @@index([billingStatus])
  @@index([timestamp])
  @@index([businessId, timestamp])
}

model BillingPlan {
  id              String            @id @default(cuid())
  name            String
  description     String?
  billingCycle    String            @default("MONTHLY") // MONTHLY, ANNUALLY
  status          String            @default("ACTIVE")  // ACTIVE, INACTIVE
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  rules           BillingRule[]
  businesses      BusinessBilling[]
  subscriptions   Subscription[]
}

model BillingRule {
  id              String            @id @default(cuid())
  planId          String
  plan            BillingPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  eventType       String            // e.g. TOKEN_COMPLETED
  price           Decimal           @db.Decimal(10, 2)
  slabConfig      Json?             // Flexible configuration for tiering slabs
  ruleType        String            @default("PER_EVENT") // PER_EVENT, FLAT_RATE, SUBSCRIPTION
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([planId, eventType])
}

model BusinessBilling {
  id                  String      @id @default(cuid())
  businessId          String      @unique // Clinic.id
  planId              String
  plan                BillingPlan @relation(fields: [planId], references: [id])
  customPricing       Json?       // EventType -> Price overrides (e.g. {"TOKEN_COMPLETED": 4.50})
  billingCycleStart   DateTime?
  billingCycleEnd     DateTime?
  status              String      @default("ACTIVE") // ACTIVE, SUSPENDED
  outstandingAmount   Decimal     @default(0.00) @db.Decimal(10, 2)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique // INV-YYYYMM-XXXX
  businessId      String
  startDate       DateTime
  endDate         DateTime
  subtotal        Decimal       @db.Decimal(10, 2)
  discount        Decimal       @default(0.00) @db.Decimal(10, 2)
  tax             Decimal       @default(0.00) @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  status          String        @default("UNPAID") // UNPAID, PAID, VOID
  generatedDate   DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           InvoiceItem[]
  payments        Payment[]

  @@index([businessId])
  @@index([startDate, endDate])
}

model InvoiceItem {
  id              String      @id @default(cuid())
  invoiceId       String
  invoice         Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  eventType       String
  eventCount      Int
  unitPrice       Decimal     @db.Decimal(10, 2)
  totalPrice      Decimal     @db.Decimal(10, 2)
  slabDetails     String?
  createdAt       DateTime    @default(now())
}

model Payment {
  id              String        @id @default(cuid())
  invoiceId       String?
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  subscriptionId  String?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amount          Decimal       @db.Decimal(10, 2)
  status          String        @default("COMPLETED") // COMPLETED, FAILED, REFUNDED
  paymentMethod   String?
  referenceId     String?
  createdAt       DateTime      @default(now())
}

model Subscription {
  id                  String       @id @default(cuid())
  clinicId            String
  clinic              Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  planId              String
  plan                BillingPlan  @relation(fields: [planId], references: [id])
  status              String       @default("PENDING") // PENDING, ACTIVE, EXPIRED, CANCELLED, FAILED
  razorpayOrderId     String?      @unique
  razorpayPaymentId   String?      @unique
  razorpaySignature   String?
  amount              Decimal      @db.Decimal(10, 2)
  startDate           DateTime?
  endDate             DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  payments            Payment[]

  @@index([clinicId])
}

model UsageSummary {
  id              String      @id @default(cuid())
  businessId      String
  locationId      String
  professionalId  String      @default("SYSTEM")
  date            DateTime    // YYYY-MM-DD
  eventType       String
  count           Int         @default(0)
  updatedAt       DateTime    @updatedAt

  @@unique([businessId, locationId, professionalId, date, eventType])
  @@index([businessId, date])
  @@index([locationId, date])
}

enum PrescriptionStatus {
  PENDING
  TRANSCRIBING
  READY_FOR_REVIEW
  GENERATING_PDF
  COMPLETED
  FAILED
}

model Prescription {
  id                    String                 @id @default(cuid())
  visitId               String                 @unique
  visit                 Visit                  @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patientId             String
  patient               User                   @relation("PatientPrescriptions", fields: [patientId], references: [id])
  doctorId              String
  doctor                Doctor                 @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  locationId            String
  location              Location               @relation(fields: [locationId], references: [id])
  
  // Vitals (captured at time of prescription)
  weight                String?                // e.g., "72 kg"
  height                String?                // e.g., "175 cm"
  bloodPressure         String?                // e.g., "120/80 mmHg"
  temperature           String?                // e.g., "98.6 °F"
  pulse                 String?                // e.g., "72 bpm"
  spo2                  String?                // e.g., "98%"
  
  // Patient History & Clinical Findings
  symptoms              String?                // Chief complaints / Symptoms (e.g., "Fever, cough for 3 days")
  allergies             String?                // Known drug allergies (e.g., "Penicillin, Sulfa")
  clinicalNotes         String?                // Doctor's internal physical examination notes
  diagnosis             String?                // Diagnosed conditions (e.g., "Acute Bronchitis")
  investigationsOrdered String?                // Lab tests or scans requested (e.g., "CBC, Chest X-ray")
  generalAdvice         String?                // Non-pharmacological advice (diet, rest, follow-up parameters)
  referral              String?                // Referral to another specialist if any
  followUpDate          DateTime?              // Specific follow-up date
  followUpNote          String?                // e.g., "In 5 days", "If fever persists"
  
  // Audio & PDF Metadata
  audioUrl              String?                // S3 link to raw audio recording
  pdfUrl                String?                // S3 link to generated PDF
  rawTranscript         String?                // Full raw transcription from Whisper
  structuredJson        Json?                  // Raw structured output backup from GPT
  status                PrescriptionStatus     @default(PENDING)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  
  medicines             PrescriptionMedicine[]
  
  @@index([patientId])
  @@index([doctorId])
  @@index([locationId])
  @@index([createdAt])
}

model PrescriptionMedicine {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  
  // Drug Details
  medicine       String       // Brand name or generic name (e.g., "Azithromycin 500")
  genericName    String?      // Active chemical compound (e.g., "Azithromycin")
  form           String?      // Tablet, Syrup, Capsule, Ointment, Inhaler, Drops
  dosage         String       // Strength/Dose (e.g., "500 mg", "1 tablet", "5 ml")
  
  // Timing & Frequency
  frequency      String       // Text frequency (e.g., "Once Daily", "Twice Daily", "SOS")
  frequencyPattern String?    // Numeric dosing pattern (e.g., "1-0-1", "1-0-0")
  timing         String?      // Relation to meals (e.g., "Before food", "After food", "Empty stomach")
  
  // Duration & Quantity
  duration       String       // e.g., "3 Days", "1 Week", "1 Month"
  totalQuantity  Int?         // Total count of units to dispense (e.g., 10)
  notes          String?      // Special instructions (e.g., "Take with warm water")
}

model DoctorPrescriptionConfig {
  id                    String   @id @default(cuid())
  doctorId              String   @unique
  doctor                Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  
  // Layout Options & Section Order
  // Controls the order of layout blocks, e.g., ["vitals", "symptoms", "diagnosis", "medicines", "advice"]
  sectionOrder          String[] @default(["vitals", "symptoms", "diagnosis", "medicines", "advice"])
  
  // Formatting & Visibility Switches
  showLogo              Boolean  @default(true)
  showPatientAge        Boolean  @default(true)
  showPatientMobile     Boolean  @default(true)
  showPatientAddress    Boolean  @default(false)
  showDate              Boolean  @default(true)
  showSignature         Boolean  @default(true)
  showVitals            Boolean  @default(true)
  showSymptoms          Boolean  @default(true)
  showDiagnosis         Boolean  @default(true)
  showAdvice            Boolean  @default(true)
  showInvestigations    Boolean  @default(true)
  
  // Custom Letterhead Options (useful if doctor uses pre-printed letterhead pads)
  headerEnabled         Boolean  @default(true) // Set to false to hide digital header
  footerEnabled         Boolean  @default(true) // Set to false to hide digital footer
  customHeaderText      String?  // Custom clinic tagline or header text
  customFooterText      String?  // Custom clinic disclaimer/address for footer
  signatureUrl          String?  // S3 path of signature image
}

