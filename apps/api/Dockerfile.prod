# ── Stage 1: install all deps + generate Prisma client ───────────────────────
FROM node:20-slim AS deps
RUN apt-get update -y \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
# Install ALL deps (including devDeps) — needed for prisma CLI + ts-node in seed.
RUN npm ci --no-audit --no-fund
COPY prisma ./prisma
# Generate Prisma client for this platform.
RUN npx prisma generate

# ── Stage 2: compile TypeScript ───────────────────────────────────────────────
FROM deps AS builder
COPY tsconfig.json nest-cli.json ./
COPY src ./src
RUN npm run build

# ── Stage 3: lean runtime image ───────────────────────────────────────────────
FROM node:20-slim AS runner
RUN apt-get update -y \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Non-root user for defence-in-depth.
RUN addgroup --system --gid 1001 appgroup \
 && adduser  --system --uid 1001 --ingroup appgroup appuser

WORKDIR /app
ENV NODE_ENV=production

# Copy compiled app and source (needed for ts-node seed script).
COPY --from=builder --chown=appuser:appgroup /app/dist ./dist
COPY --from=builder --chown=appuser:appgroup /app/src ./src


# Copy node_modules (includes devDeps for ts-node + Prisma CLI needed by seed).
# Trade-off: larger image; avoids cross-compiling native modules (argon2).
COPY --from=deps --chown=appuser:appgroup /app/node_modules ./node_modules

# Prisma schema (needed by migrate deploy + prisma client at runtime).
COPY --chown=appuser:appgroup prisma ./prisma
COPY --chown=appuser:appgroup package.json ./

USER appuser
EXPOSE 4000

# Migrations and seed run as a Fly release_command (see fly.toml) before
# traffic switches. The machine itself just starts the app.
CMD ["node", "dist/src/main.js"]
