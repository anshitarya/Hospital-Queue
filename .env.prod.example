# ── Production environment ────────────────────────────────────────────────────
# Copy to .env on the server: cp .env.prod.example .env
# Then fill in every value marked <CHANGE>.
# NEVER commit the filled-in .env to git.

# ── Domain ────────────────────────────────────────────────────────────────────
# The domain Caddy will obtain a TLS certificate for.
# Must have an A record pointing to this server's IP before first boot.
DOMAIN=queue.yourclinic.com       # <CHANGE>

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=hq
POSTGRES_PASSWORD=<CHANGE_strong_random_password>
POSTGRES_DB=hospital_queue

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=<CHANGE_64_char_random_hex>
JWT_EXPIRES_IN=7d

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_TTL_SECONDS=300
# Set to false in production — OTPs must go via SMS, not stdout.
OTP_DEV_MODE=false

# ── Queue defaults ────────────────────────────────────────────────────────────
DEFAULT_AVG_CONSULT_MINUTES=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# Must match DOMAIN exactly (including https://).
CORS_ORIGIN=https://queue.yourclinic.com     # <CHANGE>

# ── Super admin domain gating ─────────────────────────────────────────────────
# false = /admin accessible from any domain (safe default until you own theclinicqueue.com)
# true  = /admin only accessible from SUPER_ADMIN_HOST
SUPER_ADMIN_LOCKED=false
SUPER_ADMIN_HOST=admin.theclinicqueue.com

# ── Notification feature flags ────────────────────────────────────────────────
FEATURE_SMS=false          # flip to true after MSG91 is configured
FEATURE_WHATSAPP=false     # flip to true after Meta WA is configured

# ── MSG91 SMS (India — cheapest SMS gateway) ──────────────────────────────────
# Steps: msg91.com → Sign Up → API → API Key
# MSG91_AUTH_KEY=<CHANGE>
# MSG91_SENDER_ID=CLNCQ
# MSG91_DLT_ENTITY_ID=<CHANGE_register_at_dlt_portal>

# ── Meta WhatsApp Cloud API ───────────────────────────────────────────────────
# See apps/api/src/modules/notifications/meta-whatsapp.provider.ts for full steps.
# META_WA_ACCESS_TOKEN=<CHANGE>
# META_WA_PHONE_NUMBER_ID=<CHANGE>
# META_WA_USE_TEMPLATES=false   # true = approved templates (required for cold outbound msgs)
