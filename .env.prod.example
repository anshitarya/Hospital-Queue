# ── Production environment ────────────────────────────────────────────────────
# Copy to .env on the server: cp .env.prod.example .env
# Then fill in every value marked <CHANGE>.
# NEVER commit the filled-in .env to git.

# ── Domain ────────────────────────────────────────────────────────────────────
# The domain Caddy will obtain a TLS certificate for.
# Must have an A record pointing to this server's IP before first boot.
DOMAIN=queue.yourclinic.com       # <CHANGE>

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=hq
POSTGRES_PASSWORD=<CHANGE_strong_random_password>
POSTGRES_DB=hospital_queue

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=<CHANGE_64_char_random_hex>
JWT_EXPIRES_IN=7d

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_TTL_SECONDS=300
# Set to false in production — OTPs must go via SMS, not stdout.
OTP_DEV_MODE=false

# ── Queue defaults ────────────────────────────────────────────────────────────
DEFAULT_AVG_CONSULT_MINUTES=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# Must match DOMAIN exactly (including https://).
CORS_ORIGIN=https://queue.yourclinic.com     # <CHANGE>

# ── SMS notifications (optional for V1 — leave blank to keep console stub) ───
# Uncomment and fill in when you're ready to send real OTPs / notifications.
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1234567890
