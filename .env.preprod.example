# ── Preprod environment ────────────────────────────────────────────────────────
# Copy to .env.preprod and fill in the values marked <CHANGE>.
# Used by: docker compose -f docker-compose.preprod.yml --env-file .env.preprod up --build
#
# This runs the production build locally. Good for:
#   • Smoke-testing before a Fly.io deploy
#   • Testing SMS/WhatsApp integrations without touching prod data
#   • Verifying migrations on a real Postgres image

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=hq
POSTGRES_PASSWORD=hq_preprod_password
POSTGRES_DB=hospital_queue_preprod

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=<CHANGE_any_long_random_string>
JWT_EXPIRES_IN=30d

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_TTL_SECONDS=300
OTP_DEV_MODE=true          # keep true — OTPs log to console, no real SMS sent

# ── Queue ─────────────────────────────────────────────────────────────────────
DEFAULT_AVG_CONSULT_MINUTES=7

# ── Super admin ───────────────────────────────────────────────────────────────
SUPER_ADMIN_LOCKED=false   # keep false in preprod; flip only after buying domain
SUPER_ADMIN_HOST=admin.turnos.com

# ── Notification feature flags ────────────────────────────────────────────────
# Set to true here if you want to test real SMS/WhatsApp before deploying to Fly
FEATURE_SMS=false
FEATURE_WHATSAPP=false

# ── MSG91 SMS ─────────────────────────────────────────────────────────────────
# Sign up at https://msg91.com → API → API Key
# MSG91_AUTH_KEY=<your_auth_key>
# MSG91_SENDER_ID=TURNOS
# For production DLT compliance (not needed for sandbox testing):
# MSG91_DLT_ENTITY_ID=<your_dlt_entity_id>

# ── Meta WhatsApp Cloud API ───────────────────────────────────────────────────
# See apps/api/src/modules/notifications/meta-whatsapp.provider.ts for setup guide
# META_WA_ACCESS_TOKEN=<system_user_token>
# META_WA_PHONE_NUMBER_ID=<phone_number_id>
# META_WA_USE_TEMPLATES=false   # false=text messages (dev), true=approved templates (prod)

# ── Corporate proxy (Flipkart / VPN) ─────────────────────────────────────────
# Set to 1 ONLY if Docker build fails with SSL cert errors on your corp network.
INSECURE_SSL=0
