# Shared env file. Copy to .env at repo root for docker-compose.
# Individual apps also read from this via docker-compose env_file.

# --- Postgres ---
POSTGRES_USER=hq
POSTGRES_PASSWORD=hq_dev_password
POSTGRES_DB=hospital_queue
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- API ---
API_PORT=4000
DATABASE_URL=postgresql://hq:hq_dev_password@postgres:5432/hospital_queue?schema=public
REDIS_URL=redis://redis:6379
JWT_SECRET=change-me-in-production-this-is-only-for-dev
JWT_EXPIRES_IN=30d
OTP_TTL_SECONDS=300
OTP_DEV_MODE=true            # when true, the OTP is logged to stdout instead of sent via SMS
DEFAULT_AVG_CONSULT_MINUTES=7
CORS_ORIGIN=http://localhost:3000

# ── Clinic 1 (primary) ────────────────────────────────────────────────────
# These also act as global fallbacks when CLINIC_2_* vars are not set.
CLINIC_1_NAME=Demo Clinic
CLINIC_1_ADDRESS=Main Street, City
CLINIC_1_WALKIN_GAP=4
CLINIC_1_MISSED_GAP=4
CLINIC_1_FOLLOWUP_EVERY=0
CLINIC_1_AVG_CONSULT_MINUTES=7

# ── Clinic 2 ──────────────────────────────────────────────────────────────
CLINIC_2_NAME=Second Clinic
CLINIC_2_ADDRESS=42 Hospital Road, City
CLINIC_2_WALKIN_GAP=4
CLINIC_2_MISSED_GAP=4
CLINIC_2_FOLLOWUP_EVERY=0
CLINIC_2_AVG_CONSULT_MINUTES=7

# ── Clinic 3 ──────────────────────────────────────────────────────────────
CLINIC_3_NAME=City Care Clinic
CLINIC_3_ADDRESS=7 Wellness Avenue, City
CLINIC_3_WALKIN_GAP=4
CLINIC_3_MISSED_GAP=4
CLINIC_3_FOLLOWUP_EVERY=0
CLINIC_3_AVG_CONSULT_MINUTES=7

# Legacy / global fallbacks (still read by queue.service.ts defaults)
WALKIN_GAP=4
MISSED_GAP=4
FOLLOWUP_EVERY=0

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# Google Forms (doctor review survey only — business signup is stored in-app)
NEXT_PUBLIC_REVIEW_FORM_URL=https://forms.gle/C2QHX8Bv7qZGtmxr5
# Deprecated — business signup now uses POST /api/signup-requests (view in Admin → Signup requests)
# NEXT_PUBLIC_BUSINESS_SIGNUP_FORM_ACTION=...
# NEXT_PUBLIC_BUSINESS_SIGNUP_FORM_URL=...

# --- Super admin domain gating ---
SUPER_ADMIN_LOCKED=false   # keep false in dev; true only after buying domain
SUPER_ADMIN_HOST=admin.turnos.com

# --- Notification feature flags ---
FEATURE_SMS=false          # set true when MSG91 secrets are ready
FEATURE_WHATSAPP=false     # set true when Meta WA secrets are ready

# MSG91 SMS (https://msg91.com)
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=TURNOS
# MSG91_DLT_ENTITY_ID=     # required for production DLT compliance in India

# Meta WhatsApp Cloud API (https://developers.facebook.com/docs/whatsapp)
# META_WA_ACCESS_TOKEN=
# META_WA_PHONE_NUMBER_ID=
# META_WA_USE_TEMPLATES=false

# --- Production only (required for docker-compose.prod.yml) ---
# Your domain name — Caddy uses this to provision the TLS cert automatically.
DOMAIN=queue.yourhospital.com
# Comma-separated list of allowed origins for CORS + Socket.IO.
# Must match DOMAIN in production.
# CORS_ORIGIN=https://queue.yourhospital.com

# --- Build-time options ---
# Set to 1 ONLY if you're on a corporate network that intercepts TLS
# (Flipkart, BigCorp VPNs, etc.) and the Docker build fails with
# "self-signed certificate in certificate chain". Local dev only.
INSECURE_SSL=0

# --- Razorpay ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- OpenAI & S3 Object Storage ---
# OPENAI_API_KEY=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_BUCKET_NAME=hospital-prescriptions
# S3_REGION=us-east-1
# S3_PUBLIC_URL=

